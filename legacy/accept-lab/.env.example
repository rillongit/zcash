# Optional host zcash-cli. Default hop uses Docker Compose regtest (electriccoinco/zcashd).
ZCASH_CLI=
ZCASH_OBSERVER_CLI=
ZCASH_DATADIR=
# Optional ZIP-321 invoice. Default uses the receive address from data/hop-proof.json.
ZCASH_INVOICE_ADDRESS=
ZCASH_INVOICE_AMOUNT=0.001
ZCASH_GATE_HOST=127.0.0.1
ZCASH_GATE_PORT=3210
# Confirmations required before a scan or PAYMENT-SIGNATURE txid is settled.
ZCASH_SETTLED_CONFIRMATIONS=10
# Recorded decrypted notes for CI / reviewers. Do not point this at a spend key.
ZCASH_SCAN_FIXTURE=
