# Optional host zcash-cli. Default hop uses Docker Compose regtest (electriccoinco/zcashd).
ZCASH_CLI=
ZCASH_DATADIR=
# Optional ZIP-321 invoice. Default uses the receive UA from data/hop-proof.json.
ZCASH_INVOICE_ADDRESS=
ZCASH_INVOICE_AMOUNT=0.001
ZCASH_GATE_HOST=127.0.0.1
ZCASH_GATE_PORT=3210
# Viewing key for live scan. Never commit this value. TypeScript will not decrypt.
ZCASH_UFVK=
# lightwalletd gRPC (compose maps 127.0.0.1:9067).
ZCASH_LIGHTWALLETD=127.0.0.1:9067
# Recorded decrypted notes for CI / reviewers. Do not point this at a spend key.
ZCASH_SCAN_FIXTURE=
