{
  "name": "@userill/zcash",
  "version": "0.1.0",
  "description": "Shielded ZIP-321 invoices for Rill Accept",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "hop": "tsx scripts/hop.ts",
    "proof": "tsx scripts/hop.ts",
    "invoice": "tsx scripts/invoice.ts",
    "decode": "tsx scripts/decode.ts",
    "gate": "tsx scripts/gate.ts",
    "scan": "tsx scripts/scan.ts",
    "unlock": "tsx scripts/unlock.ts",
    "up": "docker compose up -d",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
